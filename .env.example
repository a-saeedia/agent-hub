# Copy to .env and fill in. Never commit the real .env.
# bridge.py and watcher/hook.py read these.

# Option 1 (native config bridge) + Option 2 (bridge.py boss)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Override which Hermes model bridge.py uses (default: free 405B)
HERMES_MODEL=nousresearch/hermes-3-llama-3.1-405b:free

# Watcher -> hub server (server/main.py default port 8000)
WATCHER_SERVER_URL=http://127.0.0.1:8000

# Hub worker: which opencode binary to invoke for /api/run directives.
# OPENCODE_BIN=<full path to opencode binary>
# HUB_WORKDIR=<working directory for hub jobs>
